# Copy to .env for local development. Never commit .env.
# With no .env at all, the app and `make test` fall back to SQLite and AI Assist is off.

DEBUG=true
SECRET_KEY=dev-only-insecure-key-change-me
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8000

# Postgres (local DBngin/Homebrew, CI, or Neon). Remove the line to use SQLite.
DATABASE_URL=postgres://postgres@localhost:5432/deskreview

# local = files on disk under backend/media; database = files stored in Postgres (used on Render)
FILE_STORAGE=local
MAX_UPLOAD_MB=5

DEMO_LOGIN_ENABLED=true
# Password for the seeded demo users (the login page's one-click buttons don't need it).
DEMO_PASSWORD=deskreview-demo

# AI Assist: gemini | fake | none. Unset means gemini when a key is present, otherwise none.
AI_PROVIDER=fake
GEMINI_API_KEY=
# Primary: the most capable Flash model, at its lowest thinking level for speed.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_THINKING_LEVEL=low
# Fallback: the fastest model. It races the primary when that is slow and takes over when it fails.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_THINKING_LEVEL=minimal
# Per-call timeout (a stuck call is abandoned), and how long to wait before starting the fallback.
AI_TIMEOUT_SECONDS=12
AI_HEDGE_SECONDS=4

LOG_LEVEL=INFO

# Production-only knobs (defaults shown):
# SECURE_COOKIES=        # defaults to "not DEBUG"
# NUM_PROXIES=           # set to 1 behind Render's proxy for per-IP throttling
